{"version": 1, "bsbSha256": "924a29523d74e35b91d9296444d8a2c451031b634d60b2ce7024e4e0cd17a6c4", "translation": "BSB", "themes": {"peace/anxiety": ["50004006-50004007", "60005007", "40006034", "43014027", "23026003", "19055022"], "fear/courage": ["23041010", "19056003", "55001007", "06001009", "05031006", "19027001", "19118006", "02014014"], "grief/loss": ["19034018", "40005004", "66021004", "19147003", "19030005", "19073026"], "loneliness/friendship": ["20017017", "21004009-21004010", "43015013", "58013005", "05031006", "20027017", "40011028"], "identity/worth": ["19139014", "49002010", "60002009", "62004019", "45008038-45008039", "40006026"], "forgiveness": ["49004032", "51003013", "25003022-25003023", "42019010"], "anger": ["49004026", "59001002-59001003", "20004023", "40005009", "49004002"], "family": ["08001016", "49004002", "51003013", "06024015", "04006024-04006026"], "school/work": ["59001005", "51003023", "20016003", "19090017", "46015058", "48006009", "54004012"], "purpose/decisions": ["20003005-20003006", "24029011", "59001005", "19037005", "45008028", "19119105", "20011014", "45012002"], "gratitude": ["52005018", "19107001", "51003017", "19100004", "19103002", "19118024"], "hope": ["24029011", "45015013", "23040031", "23043019", "19130005", "25003022-25003023", "58011001"], "doubt/faith": ["58011001", "40007007", "20003005-20003006", "19046010", "43016033", "40016016"], "temptation": ["45012002", "20004023", "48005022-48005023", "50004013"], "rest/sleep": ["19004008", "20003024", "40011028", "19127002", "41006031", "19062001"], "healing": ["19147003", "19030005", "47004016", "19121001-19121002"], "patience/waiting": ["19130005", "23040031", "48006009", "19062001", "50001006", "38004010"], "love": ["43003016", "62004009", "46013007", "62004019", "45008038-45008039", "36003017"], "guilt/shame": ["25003022-25003023", "42019010", "23043019", "50001006", "45008038-45008039"], "joy": ["16008010", "19016011", "43015011", "19118024", "42002010-42002011"], "trust": ["20003005-20003006", "19056003", "19037005", "19091001", "19023001", "19046001"], "strength": ["23040029", "50004013", "47012009", "23040031", "19046001", "19073026", "19121001-19121002"], "change": ["23043019", "45012002", "50001006", "47004016", "58013005"], "serving others": ["48006002", "50002003", "40005016", "33006008", "47009007", "40005014"]}, "chipThemes": {"anxious": ["peace/anxiety"], "sad": ["grief/loss", "hope"], "lonely": ["loneliness/friendship"], "grateful": ["gratitude", "joy"], "angry": ["anger", "forgiveness"], "confused": ["purpose/decisions", "doubt/faith"], "hopeful": ["hope", "fear/courage"], "tired": ["rest/sleep", "strength"], "big decision": ["purpose/decisions", "trust"], "anxiety": ["peace/anxiety"], "courage": ["fear/courage"], "fear": ["fear/courage"], "friendship": ["loneliness/friendship"], "gratitude": ["gratitude"], "grief": ["grief/loss"], "hope": ["hope"], "identity": ["identity/worth"], "school": ["school/work"], "sleep": ["rest/sleep"]}, "crisisSet": ["19034018", "23041010", "40011028"], "poemReply": ["05001031", "23046004"], "hardDay": ["23046004"], "stories": [{"id": "elijah-juniper", "ref": "1 Kings 19:3-8", "themes": ["rest/sleep", "strength", "hope"], "summary": "Elijah was so worn out he sat under a juniper tree and wanted to give up. God didn't scold him; an angel brought bread and water and let him sleep before the next step."}, {"id": "hannah-prayer", "ref": "1 Samuel 1:9-18", "themes": ["grief/loss", "peace/anxiety", "patience/waiting"], "summary": "Hannah was so sad that she prayed without words, just moving her lips. She poured out her heart to God, and afterward she was no longer downcast."}, {"id": "ruth-naomi", "ref": "Ruth 1:16-18", "themes": ["loneliness/friendship", "family", "grief/loss"], "summary": "After loss left Naomi alone, Ruth refused to leave her. Ruth chose loyalty and walked into an unknown future beside her."}, {"id": "david-goliath", "ref": "1 Samuel 17:32-50", "themes": ["fear/courage", "trust", "identity/worth"], "summary": "Everyone said David was too young to face Goliath. David went anyway, trusting God more than the size of the problem."}, {"id": "joseph-good", "ref": "Genesis 50:15-21", "themes": ["forgiveness", "family", "hope"], "summary": "Joseph's brothers sold him, and years later they feared his revenge. Joseph forgave them and saw that God had brought good out of what they meant for harm."}, {"id": "prodigal-son", "ref": "Luke 15:11-24", "themes": ["guilt/shame", "forgiveness", "love"], "summary": "A son wasted everything and came home expecting to be a servant. His father ran to meet him and threw a party instead."}, {"id": "peter-restored", "ref": "John 21:15-19", "themes": ["guilt/shame", "forgiveness", "purpose/decisions"], "summary": "Peter had denied knowing Jesus three times. Jesus met him by the sea and gave him a new start and a new purpose."}, {"id": "storm-calmed", "ref": "Mark 4:35-41", "themes": ["peace/anxiety", "fear/courage", "trust"], "summary": "A storm hit while the disciples were in a boat and they panicked. Jesus spoke to the wind and the sea grew calm."}, {"id": "thomas-doubt", "ref": "John 20:24-29", "themes": ["doubt/faith"], "summary": "Thomas said he couldn't believe without seeing. Jesus met him in his doubt instead of pushing him away."}, {"id": "woman-well", "ref": "John 4:5-29", "themes": ["identity/worth", "guilt/shame", "loneliness/friendship"], "summary": "A woman came to the well alone at noon to avoid people. Jesus talked with her kindly and she ran to tell the whole town."}, {"id": "jesus-wept", "ref": "John 11:32-36", "themes": ["grief/loss", "love"], "summary": "When His friend Lazarus died, Jesus cried with the family. Grief and faith stood in the same place."}, {"id": "mary-martha", "ref": "Luke 10:38-42", "themes": ["rest/sleep", "school/work", "peace/anxiety"], "summary": "Martha was busy and stressed while Mary sat and listened to Jesus. Jesus gently told Martha she was worried about many things."}]}